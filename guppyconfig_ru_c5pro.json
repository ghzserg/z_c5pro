{
  "config_path": "/root/guppyscreen/guppyconfig.json",
  "default_printer": "C5Pro",
  "display_brightness": 90,
  "display_rotate": 1,
  "display_sleep_sec": -1,
  "guppy_init_script": "/etc/init.d/S80guppyscreen",
  "log_path": "/opt/config/mod_data/log/guppyscreen.log",
  "printers": {
    "C5Pro": {
      "default_macros": {
        "cooldown": "TURN_OFF_HEATERS",
        "load_filament": "LOAD_FILAMENT"
      },
      "fans": [
        {
          "display_name": "M106",
          "id": "fan_generic fanM106"
        },
        {
          "display_name": "Камера",
          "id": "fan_generic chamber_fan"
        },
        {
          "display_name": "Нагрев Кам.",
          "id": "fan_generic chamber_heat_fan"
        },
        {
          "display_name": "Циркул. Кам.",
          "id": "fan_generic chamber_loop_fan"
        },
        {
          "display_name": "Охлажд. Кам.",
          "id": "fan_generic chamber_cool_fan"
        }
      ],
      "leds": null,
      "log_level": "debug",
      "monitored_sensors": [
        {
          "color": "red",
          "controllable": true,
          "display_name": "T0",
          "id": "extruder"
        },
        {
          "color": "orange",
          "controllable": true,
          "display_name": "T1",
          "id": "extruder1"
        },
        {
          "color": "yellow",
          "controllable": true,
          "display_name": "T2",
          "id": "extruder2"
        },
        {
          "color": "green",
          "controllable": true,
          "display_name": "T3",
          "id": "extruder3"
        },
        {
          "color": "purple",
          "controllable": true,
          "display_name": "Стол",
          "id": "heater_bed"
        },
        {
          "color": "purple",
          "controllable": true,
          "display_name": "Камера",
          "id": "chamber_heater"
        }
      ],
      "moonraker_api_key": false,
      "moonraker_host": "127.0.0.1",
      "moonraker_port": 7125
    }
  },
  "prompt_emergency_stop": true,
  "thumbnail_path": "/usr/data/tmp",
  "touch_calibrated": false,
  "wpa_supplicant": "/var/run/wpa_supplicant"
}
